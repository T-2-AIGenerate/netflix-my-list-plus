{
  "manifest_version": 3,
  "name": "Netflix マイリスト Plus",
  "version": "1.9.3",
  "description": "Netflixのマイリストを整理するローカル専用ツール（自動取得・上映時間ソート・一括視聴状況管理）",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.netflix.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "network-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
